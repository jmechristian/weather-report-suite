# Transaction-mode pooler (IPv4) — app / serverless. Port 6543.
# Dashboard → Database → Connect → Connection pooling → Transaction
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Session-mode pooler — migrate, seed, ingest. Port 5432.
# Dashboard → Database → Connect → Connection pooling → Session
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPTILER_KEY=

TRACERFY_API_KEY=
# Optional. Tracerfy has no dashboard webhook secret — leave blank.
# Only needed later if we invent our own shared token for /api/webhooks/trace/tracerfy
TRACERFY_WEBHOOK_SECRET=

# NWS requires a contact string; IEM does not need a key
NWS_USER_AGENT=storm-leads (you@company.com)

CRON_SECRET=
ALLOWED_EMAILS=you@company.com
